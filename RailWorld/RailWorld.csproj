<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
	</PropertyGroup>

	<PropertyGroup>
		<GameVersion>1.22.3</GameVersion>
	</PropertyGroup>

	<PropertyGroup>
		<AssetsPath>$(SolutionDir)/$(AssemblyName)/assets/</AssetsPath>
	</PropertyGroup>

	<PropertyGroup Label="UserMacros">
		<BinaryDir Condition="'$(Configuration)'=='Debug'">$(SolutionDir)/Testing/$(AssemblyName)-$(Version)-for-$(GameVersion)</BinaryDir>

		<ExcludeFiles Condition="'$(Configuration)'=='Debug'">
			**/VintagestoryAPI.*;
			**/VSCreativeMod.*;
			**/VSEssentials.*;
			**/VSSurvivalMod.*
		</ExcludeFiles>


		<BinaryDir Condition="'$(Configuration)'=='Release'">$(SolutionDir)/Release/$(AssemblyName)-$(Version)-for-$(GameVersion)</BinaryDir>

		<ExcludeFiles Condition="'$(Configuration)'=='Release'">
			**/VintagestoryAPI.*;
			**/VSCreativeMod.*;
			**/VSEssentials.*;
			**/VSSurvivalMod.*;
			**/*.pdb;
		</ExcludeFiles>

	</PropertyGroup>

	<ItemGroup>

		<Content Include="assets/**">
			<CopyToOutputDirectory>Never</CopyToOutputDirectory>
		</Content>

		<None Update="modinfo.json">
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</None>
		<None Update="worldconfig.json">
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</None>
		<OutFiles Include="$(OutDir)/**" Exclude="$(ExcludeFiles)" />
	</ItemGroup>

	<ItemGroup>
		<Reference Include="$(VINTAGE_STORY)\$(GameVersion)\Lib\Newtonsoft.Json.dll">
			<Private>false</Private>
		</Reference>
		<Reference Include="$(VINTAGE_STORY)\$(GameVersion)\VintagestoryAPI.dll">
			<Private>false</Private>
		</Reference>
		<Reference Include="$(VINTAGE_STORY)\$(GameVersion)\VintagestoryLib.dll">
			<Private>false</Private>
		</Reference>
		<Reference Include="$(VINTAGE_STORY)\$(GameVersion)\Mods\VSCreativeMod.dll">
			<Private>false</Private>
		</Reference>
		<Reference Include="$(VINTAGE_STORY)\$(GameVersion)\Mods\VSEssentials.dll">
			<Private>false</Private>
		</Reference>
		<Reference Include="$(VINTAGE_STORY)\$(GameVersion)\Mods\VSSurvivalMod.dll">
			<Private>false</Private>  
		</Reference>
    <Reference Include="$(VINTAGE_STORY)\$(GameVersion)\Lib\protobuf-net.dll">
			<Private>false</Private>
    </Reference>
    <Reference Include="$(VINTAGE_STORY)\$(GameVersion)\Lib\0Harmony.dll">
      <Private>false</Private>
    </Reference>
    <Reference Include="$(VINTAGE_STORY)\$(GameVersion)\Lib\OpenTK.Core.dll">
      <Private>false</Private>
    </Reference>
    <Reference Include="$(VINTAGE_STORY)\$(GameVersion)\Lib\OpenTK.Graphics.dll">
      <Private>false</Private>
    </Reference>
    <Reference Include="$(VINTAGE_STORY)\$(GameVersion)\Lib\OpenTK.Input.dll">
      <Private>false</Private>
    </Reference>
    <Reference Include="$(VINTAGE_STORY)\$(GameVersion)\Lib\OpenTK.Mathematics.dll">
      <Private>false</Private>
    </Reference>
    <Reference Include="$(VINTAGE_STORY)\$(GameVersion)\Lib\OpenTK.Windowing.Common.dll">
      <Private>false</Private>
    </Reference>
    <Reference Include="$(VINTAGE_STORY)\$(GameVersion)\Lib\OpenTK.Windowing.Desktop.dll">
      <Private>false</Private>
    </Reference>
    <Reference Include="$(VINTAGE_STORY)\$(GameVersion)\Lib\OpenTK.Windowing.GraphicsLibraryFramework.dll">
      <Private>false</Private>
    </Reference>
    <Reference Include="$(VINTAGE_STORY)\$(GameVersion)\Lib\OpenTK.Compute.dll">
      <Private>false</Private>
    </Reference>
    <Reference Include="$(VINTAGE_STORY)\$(GameVersion)\Lib\OpenTK.Audio.OpenAL.dll">
      <Private>false</Private>
    </Reference>
	</ItemGroup>

	<ItemGroup>
		<Folder Include="assets\RailWorld\" />
	</ItemGroup>


	<!-- SkipCopyToGame: для запуску тестів, коли гра відкрита і тримає файли мода -->
	<Target Name="CopyToBin1" AfterTargets="Build" Condition="'$(SkipCopyToGame)' != 'true'">

		<!-- copy compiled output files -->
		<Copy SourceFiles="@(OutFiles)" DestinationFiles="@(OutFiles->'$(BinaryDir)/%(RecursiveDir)%(Filename)%(Extension)')" />

		<!-- Ресурси мода йдуть у збірку для випуску. У збірці для відладки їх немає навмисно: гра бере їх просто
		     з папки проєкту через addOrigin (Properties/launchSettings.json), і дві копії заважали б одна одній.
		     Назви папок у нижньому регістрі: гра шукає домен railworld. Заготовки для редактора моделей
		     (shapes/reference) грі не потрібні -->
		<ItemGroup Condition="'$(Configuration)'=='Release'">
			<Assets Include="assets/**" Exclude="assets/**/shapes/reference/**" />
		</ItemGroup>
		<Copy SourceFiles="@(Assets)" DestinationFiles="@(Assets-&gt;'$(BinaryDir)/assets/$([System.String]::Copy('%(Assets.RecursiveDir)').ToLowerInvariant())%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
	</Target>


	<Target Name="CleanBin" AfterTargets="Clean">
		<RemoveDir Directories="$(SolutionDir)/Testing" />
	</Target>

	<ProjectExtensions>
		<VisualStudio>
			<UserProperties />
		</VisualStudio>
	</ProjectExtensions>
</Project>